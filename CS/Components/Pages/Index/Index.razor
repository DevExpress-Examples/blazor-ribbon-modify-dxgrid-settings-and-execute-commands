@page "/"
@inject DataService DataService

<DxRibbon>
	<DxRibbonApplicationTab Text="Export" IconUrl="images/ribbon/share.svg">
		<DxRibbonApplicationTabItem Text="CSV"
									IconUrl="images/ribbon/table.svg"
									Click="Grid_ExportToCsv" />
		<DxRibbonApplicationTabItem Text="PDF"
									IconUrl="images/ribbon/document-blank.svg"
									Click="Grid_ExportToPdf" />
		<DxRibbonApplicationTabItem Text="XLSX"
									IconUrl="images/ribbon/table.svg"
									Click="Grid_ExportToXlsx" />
	</DxRibbonApplicationTab>
	<DxRibbonTab Text="Home">
		<DxRibbonGroup Text="Grid Customization">
			<DxRibbonToggleItem Text="@(ShowSearchBox ? "Hide Search Box" : "Show Search Box")"
								IconUrl="images/ribbon/search.svg"
								Tooltip="Toggle Search Box"
								Click="Grid_ToggleSearch" />
			<DxRibbonToggleItem Text="@(ShowFilterPanel ? "Hide Filter Panel" : "Show Filter Panel")"
								Tooltip="Toggle Filter Panel"
								IconUrl="images/ribbon/grid-toolbar-filter.svg"
								Click="Grid_ToggleFilterPanel" />
			<DxRibbonToggleItem Text="@(ShowGroupPanel ? "Hide Group Panel" : "Show Group Panel")"
								Tooltip="Toggle Group Panel"
								Click="Grid_ToggleGroupPanel" />
			<DxRibbonItem Text="Show Column Chooser"
						  Tooltip="Show Column Chooser"
						  IconUrl="images/ribbon/column-chooser-fluent.svg"
						  Click="Grid_ShowColumnChooser" />
			<DxRibbonToggleItem Text="@(categoryGroupIndex == 0 ? "Enable Grouping" : "Disable Grouping")"
								Tooltip="Toggle Grouping"
								IconUrl="images/ribbon/grouping.svg"
								Click="Grid_ToggleGrouping" />
			<DxRibbonItem Text="Total Summary"
						  SplitDropDownButton="true"
						  Tooltip="Total Summary"
						  Click="Grid_ToggleSummaries"
						  IsPrimary="true">
				<DxRibbonToggleItem Text="Product Name" Checked="@productNameSummary" Click="Grid_ToggleProductNameSummary" />
				<DxRibbonToggleItem Text="Unit Price" Checked="@unitPriceSummary" Click="Grid_ToggleUnitPriceSummary" />
				<DxRibbonToggleItem Text="Units in Stock" Checked="@unitsInStockSummary" Click="Grid_ToggleUnitsInStockSummary" />
			</DxRibbonItem>
			<DxRibbonItem Text="Items on Page:"
						  Enabled="false"
						  CssClass="rb-text-item" />
			<DxRibbonSpinEditItem Value="@ItemsOnPage"
								  MinValue="5"
								  MaxValue="32"
								  Increment="1"
								  Width="100px"
								  ValueChanged="@((int newValue) => ItemsOnPageChanged(newValue))" />
		</DxRibbonGroup>
	</DxRibbonTab>
	<DxRibbonTab Text="Data">
		<DxRibbonGroup Text="Data">
			<DxRibbonItem Text="New Item"
						  IconUrl="images/ribbon/document-blank.svg"
						  Tooltip="New Item"
						  Click="Grid_NewItem" />
			<DxRibbonItem Text="Delete Item"
						  IconUrl="images/ribbon/delete.svg"
						  Tooltip="Delete Item"
						  Click="Grid_DeleteItem" />
			<DxRibbonItem Text="Edit Mode:"
						  Enabled="false"
						  IconUrl="images/ribbon/grid-toolbar-edit.svg"
						  CssClass="rb-text-item" />
			<DxRibbonComboBoxItem Data="EditModes"
								  @bind-Value="CurrentEditMode"
								  TextFieldName="@nameof(GridEditMode)" />
			<DxRibbonItem Text="Export"
						  IconUrl="images/ribbon/share.svg"
						  SplitDropDownButton="true"
						  IsPrimary="true"
						  Tooltip="Export">
				<DxRibbonItem Text="CSV" Tooltip="CSV"
							  IconUrl="images/ribbon/table.svg"
							  Click="Grid_ExportToCsv" />
				<DxRibbonItem Text="PDF" Tooltip="PDF"
							  IconUrl="images/ribbon/document-blank.svg"
							  Click="Grid_ExportToPdf" />
				<DxRibbonItem Text="XLSX" Tooltip="XLSX"
							  IconUrl="images/ribbon/table.svg"
							  Click="Grid_ExportToXlsx" />
			</DxRibbonItem>
		</DxRibbonGroup>
	</DxRibbonTab>
</DxRibbon>
<DxGrid Data="@products"
		KeyFieldName="@nameof(Product.ProductID)"
		@ref="grid"
		EditMode="@CurrentEditMode"
		ShowFilterRow="@ShowFilterPanel"
		ShowGroupPanel="@ShowGroupPanel"
		ShowSearchBox="@ShowSearchBox"
		AutoExpandAllGroupRows="true"
		FocusedRowEnabled="true"
		AllowSelectRowByClick="true"
		FocusedRowChanged="OnFocusedDataItemChanged"
		DataItemDeleting="OnDataItemDeleting"
		EditModelSaving="OnEditModelSaving"
		CustomizeEditModel="OnCustomizeEditModel"
		PageSize="@ItemsOnPage">
	<EditFormTemplate Context="editFormContext">
		@{
			var product = (Product)editFormContext.EditModel;
		}
		<DxFormLayout>
			<DxFormLayoutItem Caption="Product Name:">
				@editFormContext.GetEditor("ProductName")
			</DxFormLayoutItem>
			<DxFormLayoutItem Caption="Category:">
				<DxComboBox Data="@categories"
							Value="@product.CategoryID"
							ValueChanged="@((int? newValue) => product.CategoryID = newValue)"
							ValidationEnabled="false"
							SearchMode="@ListSearchMode.AutoSearch"
							SearchFilterCondition="@ListSearchFilterCondition.Contains"
							TextFieldName="@nameof(Category.CategoryName)"
							ValueFieldName="@nameof(Category.CategoryID)">
				</DxComboBox>
			</DxFormLayoutItem>
			<DxFormLayoutItem Caption="Unit Price:">
				@editFormContext.GetEditor("UnitPrice")
			</DxFormLayoutItem>
			<DxFormLayoutItem Caption="Units In Stock:">
				@editFormContext.GetEditor("UnitsInStock")
			</DxFormLayoutItem>
			<DxFormLayoutItem Caption="Restock Date:">
				@editFormContext.GetEditor("RestockDate")
			</DxFormLayoutItem>
			<DxFormLayoutItem Caption="Discontinued:">
				@editFormContext.GetEditor("Discontinued")
			</DxFormLayoutItem>
		</DxFormLayout>
	</EditFormTemplate>
	<Columns>
		<DxGridDataColumn FieldName="@nameof(Product.ProductID)" Width="90px" ReadOnly="true" />
		<DxGridDataColumn FieldName="@nameof(Product.ProductName)" MinWidth="200" Width="50%" />
		<DxGridDataColumn FieldName="@nameof(Product.CategoryID)"
						  Caption="Category"
						  MinWidth="150">
			<EditSettings>
				<DxComboBoxSettings Data="@categories"
									ValueFieldName="@nameof(Category.CategoryID)"
									TextFieldName="@nameof(Category.CategoryName)" />
			</EditSettings>
		</DxGridDataColumn>
		<DxGridDataColumn FieldName="@nameof(Product.UnitPrice)"
						  DisplayFormat="c2"
						  MinWidth="130"
						  SortOrder="GridColumnSortOrder.Ascending"
						  SortIndex="0" />
		<DxGridDataColumn FieldName="@nameof(Product.UnitsInStock)"
						  MinWidth="130"
						  SortOrder="GridColumnSortOrder.Descending"
						  SortIndex="1" />
		<DxGridDataColumn FieldName="@nameof(Product.RestockDate)"
						  DisplayFormat="d"
						  MinWidth="130" />
		<DxGridDataColumn FieldName="@nameof(Product.Discontinued)" MinWidth="130" />
	</Columns>
	<TotalSummary>
		<DxGridSummaryItem FieldName="@nameof(Product.ProductName)"
						   SummaryType="GridSummaryItemType.Count" Visible="@productNameSummary" />
		<DxGridSummaryItem FieldName="@nameof(Product.UnitPrice)"
						   SummaryType="GridSummaryItemType.Avg"
						   ValueDisplayFormat="c2" Visible="@unitPriceSummary" />
		<DxGridSummaryItem FieldName="@nameof(Product.UnitsInStock)"
						   SummaryType="GridSummaryItemType.Sum" Visible="@unitsInStockSummary" />
	</TotalSummary>
</DxGrid>
@code {

	public static readonly GridEditMode[] EditModes = new GridEditMode[] {
				GridEditMode.EditCell,
				GridEditMode.EditForm,
				GridEditMode.PopupEditForm,
				GridEditMode.EditRow
	};

	private GridEditMode CurrentEditMode { get; set; } = EditModes[0];

	private void ItemsOnPageChanged(int newValue) {
		ItemsOnPage = newValue;
		grid.BeginUpdate();
		grid.PageSize = ItemsOnPage;
		grid.EndUpdate();
	}

	const string ExportFileName = "ExportResult";
	bool ShowSearchBox { get; set; } = false;
	bool ShowFilterPanel { get; set; } = false;
	bool ShowGroupPanel { get; set; } = false;
	bool showColumnChooser { get; set; } = false;
	byte categoryGroupIndex { get; set; } = 0;

	bool productNameSummary { get; set; } = false;
	bool unitPriceSummary { get; set; } = false;
	bool unitsInStockSummary { get; set; } = false;

	int ItemsOnPage { get; set; } = 10;

	Product SelectedDataItem { get; set; }

	int FocusedRowVisibleIndex { get; set; }
	DxGrid grid { get; set; }
	List<Product> products = new();
	List<Category> categories = new();

	void OnFocusedDataItemChanged(GridFocusedRowChangedEventArgs e) {
		if (e.DataItem != null) {
			SelectedDataItem = (Product)e.DataItem;
		}
	}

	protected override void OnInitialized() {
		products = DataService.GetProducts().ToList();
		categories = DataService.GetCategories().ToList();
	}

	async Task Grid_NewItem() {
		await grid.StartEditNewRowAsync();
	}
	void Grid_DeleteItem() {
		grid.ShowRowDeleteConfirmation(FocusedRowVisibleIndex);
	}
	void Grid_ShowColumnChooser() {
		grid.ShowColumnChooser();
	}
	async Task Grid_ExportToXlsx() {
		await grid.ExportToXlsxAsync(ExportFileName);
	}
	async Task Grid_ExportToCsv() {
		await grid.ExportToCsvAsync(ExportFileName);
	}
	async Task Grid_ExportToPdf() {
		await grid.ExportToPdfAsync(ExportFileName);
	}
	async Task Grid_ToggleSearch() {
		ShowSearchBox = !ShowSearchBox;
		await Task.CompletedTask;
	}
	async Task Grid_ToggleFilterPanel() {
		ShowFilterPanel = !ShowFilterPanel;
		await Task.CompletedTask;
	}
	async Task Grid_ToggleGroupPanel() {
		ShowGroupPanel = !ShowGroupPanel;
		await Task.CompletedTask;
	}
	async Task Grid_ToggleGrouping() {
		grid.BeginUpdate();
		if (categoryGroupIndex == 0) {
			grid.GroupBy("CategoryID", 1);
			categoryGroupIndex = 1;
		}
		else {
			grid.GroupBy("CategoryID", -1);
			categoryGroupIndex = 0;
		}
		grid.EndUpdate();
		await Task.CompletedTask;
	}
	async Task Grid_ToggleProductNameSummary() {
		productNameSummary = !productNameSummary;
		await Task.CompletedTask;
	}
	async Task Grid_ToggleUnitPriceSummary() {
		unitPriceSummary = !unitPriceSummary;
		await Task.CompletedTask;
	}
	async Task Grid_ToggleUnitsInStockSummary() {
		unitsInStockSummary = !unitsInStockSummary;
		await Task.CompletedTask;
	}
	async Task Grid_ToggleSummaries() {
		bool allOff = !productNameSummary && !unitPriceSummary && !unitsInStockSummary;

		productNameSummary = allOff;
		unitPriceSummary = allOff;
		unitsInStockSummary = allOff;

		StateHasChanged();
		await Task.CompletedTask;
	}

	async Task<List<Product>> OnEditModelSaving(GridEditModelSavingEventArgs e) {
		if (e.IsNew)
			await Task.Run(() => products.Add((Product)e.EditModel));
		return products;
	}
	async Task OnDataItemDeleting(GridDataItemDeletingEventArgs e) {
		products.Remove(SelectedDataItem);
	}
	void OnCustomizeEditModel(GridCustomizeEditModelEventArgs e) {
		if (e.IsNew) {
			var editModel = (Product)e.EditModel;
			editModel.ProductID = products.Max(x => x.ProductID) + 1;
		}
	}
}